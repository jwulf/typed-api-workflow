{
  "name": "example-coverage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "example-coverage": "bin/example-coverage"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc -p .",
    "start": "npm run build && node --no-warnings dist/index.js ../../rest-api.domain.yaml",
    "report": "npm run build && node --no-warnings dist/index.js --format json --out ../../analysis/example-coverage.json ../../rest-api.domain.yaml",
    "check:coverage": "npm run build && node --no-warnings dist/index.js --fail-under 90 ../../rest-api.domain.yaml"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.0.3",
    "chalk": "^5.3.0",
    "openapi-types": "^12.1.3",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
